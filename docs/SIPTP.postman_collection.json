	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (pm.request.method !== 'GET') {",
					"    pm.sendRequest({",
					"        url: pm.environment.get('base_url') + '/login',",
					"        method: 'GET'",
					"    }, function (err, res) {",
					"        if (!err && res) {",
					"            var match = res.text().match(/<meta name=\"csrf-token\" content=\"([^\"]+)\"/);",
					"            if (match && match[1]) {",
					"                pm.request.headers.add({",
					"                    key: 'X-CSRF-TOKEN',",
					"                    value: match[1]",
					"                });",
					"            }",
					"        }",
					"    });",
					"}"
				]
			}
		}
	]
}
